{
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  // "modules-left": ["hyprland/workspaces", "custom/playerctl", "custom/previous", "custom/pause", "custom/next"],
  // "modules-center": ["hyprland/window"],
  "modules-left": [
    "custom/timer",
    "custom/previous",
    "custom/pause",
    "custom/next",
    "custom/playerctl"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "battery",
    "clock",
    "custom/notification"
  ],
  "clock": {
    "format": "<span size='16pt' rise='-1600' foreground='#D1D5FF'> </span>{:%d/%m/%y %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "gnome-calendar"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "show-passive-items": true,
    "reverse-direction": true
  },
  "custom/timer": {
    "format": "<span size='16pt' rise='-1600'>󰔛</span>",
    "tooltip": false,
    "return-type": "json",
    // "exec": "sh /home/alessio/github/dotfiles/apps/ags_test/script.sh info",
    "on-click": "sh /home/alessio/github/dotfiles/apps/ags_test/script.sh toggle"
  },
  "custom/playerctl": {
    "format": "{}",
    "return-type": "json",
    "max-length": 40,
    "exec": "$HOME/.local/lib/waybar/audio_process.sh 2> /dev/null",
    "on-click": "playerctl play-pause"
  },
  "custom/previous": {
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "tooltip-format": "",
    "exec": "$HOME/.local/lib/waybar/bar_player_buttons.sh previous",
    "on-click": "playerctl previous"
  },
  "custom/pause": {
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "tooltip-format": "",
    "exec": "$HOME/.local/lib/waybar/bar_player_buttons.sh play",
    "on-click": "playerctl  play-pause"
  },
  "custom/next": {
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "tooltip-format": "",
    "exec": "$HOME/.local/lib/waybar/bar_player_buttons.sh next",
    "on-click": "playerctl  next"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{} <span size='16pt' rise='-1600'>{icon}</span>",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/home/alessio/github/dotfiles/waybar/.config/waybar/menu.xml",
    "menu-actions": {
      "shutdown": "",
      "reboot": "",
      "suspend": "",
      "hibernate": ""
    }
  },
  "battery": {
    "exec": "",
    "interval": 1,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='16pt' rise='-1600'>{icon}</span> {capacity}%",
    "format-warning": "{icon} {capacity}%",
    "format-critical": "{icon} {capacity}%",
    "format-charging": "<span size='16pt' rise='-1600'></span> {capacity}%",
    "format-plugged": "<span size='16pt' rise='-1600'></span> {capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "<span size='16pt' rise='-1600'></span> {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{time}\n{health}"
  },
  "upower#headset": {
    "native-path": "/org/freedesktop/UPower/devices/headphones_dev_04_52_C7_5F_FB_CA",
    "tooltip": "{model}",
    "format": "<span size='16pt' rise='-1600'>󰋋</span> {percentage}",
    "show-icon": false
  },
  "network": {
    "format-wifi": "<span size='16pt' rise='-1600'></span>",
    "format-ethernet": "󰤭 Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "nmgui"
  },
  "pulseaudio": {
    "format": "<span size='16pt' rise='-1600'>{icon}</span> {volume}%",
    "format-muted": "<span size='16pt' rise='-1600'></span>",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "backlight": {
    "justify": "center",
    "format": "<span size='16pt' rise='-1600'>{icon}</span> {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "bluetooth": {
    "format": "",
    "hide-if-empty": true,
    "format-disabled": "",
    "format-connected": "<span size='16pt' rise='-1600'></span> {num_connections}",
    "format-connected-battery": "<span font='16pt' rise='0'>󰋋</span> {device_battery_percentage}%",
    "format-device-preference": [
      "device2",
      "device1"
    ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}: {device_battery_percentage}%",
    "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%"
  }
}
